[
  {"name": "table: escaped pipe and inline code", "markdown": "| a | b |\n| - | - |\n| `x \\| y` | c \\| d |\n"},
  {"name": "table: missing and extra cells", "markdown": "| a | b | c |\n| --- | :-: | --: |\n| 1 |\n| 1 | 2 | 3 | 4 |\n"},
  {"name": "table: no body", "markdown": "| a | b |\n| --- | --- |\n"},
  {"name": "table: no outer pipes", "markdown": "a | b\n--|--\n1 | 2\n"},
  {"name": "table: interrupted by a block", "markdown": "| a |\n| - |\n| b |\n> quote\n"},
  {"name": "table: inline content", "markdown": "| **b** | *i* | [l](/u) | ![i](/i.png) |\n|---|---|---|---|\n| ~~s~~ | <kbd>K</kbd> | x<br>y | &amp; |\n"},
  {"name": "table: after a paragraph", "markdown": "Paragraph\n| a | b |\n| - | - |\n| 1 | 2 |\n"},
  {"name": "task list: upper-case X", "markdown": "- [X] done\n- [ ] open\n"},
  {"name": "task list: ordered", "markdown": "1. [x] one\n2. [ ] two\n"},
  {"name": "task list: loose", "markdown": "- [x] one\n\n- [ ] two\n"},
  {"name": "task list: with a second paragraph", "markdown": "- [x] one\n\n  more text\n"},
  {"name": "task list: mixed with plain items", "markdown": "- plain\n- [x] task\n- [ ]\n- [ ]not a task\n"},
  {"name": "task list: empty after marker", "markdown": "- [x] \n"},
  {"name": "strikethrough: single and double", "markdown": "~one~ and ~~two~~ and ~~~three~~~\n"},
  {"name": "strikethrough: unmatched", "markdown": "~~a ~b~~ c~\n"},
  {"name": "strikethrough: across emphasis", "markdown": "~~*a*~~ *~~b~~*\n"},
  {"name": "autolink: www and trailing punctuation", "markdown": "Visit www.commonmark.org. Or www.commonmark.org/a.b, then (www.x.com) and www.x.com/(a)).\n"},
  {"name": "autolink: http with path and query", "markdown": "See https://example.com/path?a=1&b=2#frag and http://x.org/~u/.\n"},
  {"name": "autolink: email", "markdown": "Mail foo@bar.baz, a.b-c_d@a.b. and hello@mail+xyz.example.\n"},
  {"name": "autolink: entity at the end", "markdown": "www.google.com/search?q=commonmark&hl;\n"},
  {"name": "autolink: inside a link", "markdown": "[www.x.com](https://y.com) and <https://z.com>\n"},
  {"name": "footnote: repeated reference", "markdown": "One[^a] two[^a] three[^b].\n\n[^a]: First.\n[^b]: Second.\n"},
  {"name": "footnote: missing definition", "markdown": "Text[^missing].\n"},
  {"name": "footnote: unused definition", "markdown": "Text.\n\n[^unused]: Never referenced.\n"},
  {"name": "footnote: multi-paragraph definition", "markdown": "Text[^long].\n\n[^long]: First paragraph.\n\n    Second paragraph.\n\n    ```\n    code\n    ```\n"},
  {"name": "footnote: reference inside a definition", "markdown": "A[^1].\n\n[^1]: See[^2].\n[^2]: Nested.\n"},
  {"name": "footnote: label case and spaces", "markdown": "A[^Some Label].\n\n[^some label]: Def.\n"},
  {"name": "footnote: definition ending in a list", "markdown": "A[^l].\n\n[^l]: Items:\n    - one\n    - two\n"},
  {"name": "html: details with markdown", "markdown": "<details>\n<summary>Title</summary>\n\n- item **bold**\n\n</details>\n"},
  {"name": "html: img with attributes", "markdown": "<img src=\"a.png\" width=\"100\" height=\"50\" alt=\"x\" align=\"right\">\n\n<p align=\"center\"><img src=\"b.png\" width=\"40%\"></p>\n"},
  {"name": "html: picture and source", "markdown": "<picture>\n<source media=\"(prefers-color-scheme: dark)\" srcset=\"d.png\">\n<img src=\"l.png\" alt=\"logo\">\n</picture>\n"},
  {"name": "html: inline elements", "markdown": "H<sub>2</sub>O, x<sup>2</sup>, <kbd>Ctrl</kbd>, <ins>new</ins>, <del>old</del>, <mark>hi</mark>, <abbr title=\"Hyper\">H</abbr>, <q>quote</q>\n"},
  {"name": "html: comment and br", "markdown": "a<!-- hidden -->b<br>c<br/>d\n\n<!--\nblock comment\n-->\n"},
  {"name": "html: definition list", "markdown": "<dl>\n<dt>Term</dt>\n<dd>Definition</dd>\n</dl>\n"},
  {"name": "html: table with align and colspan", "markdown": "<table>\n<tr><th colspan=\"2\" align=\"left\">h</th></tr>\n<tr><td align=\"right\">1</td><td style=\"color: red\">2</td></tr>\n</table>\n"},
  {"name": "html: unclosed inline element", "markdown": "a <b>bold\n\nnext\n"},
  {"name": "html: anchor with name and target", "markdown": "<a name=\"top\"></a>\n\n<a href=\"https://x.com\" target=\"_blank\" rel=\"noopener\">x</a>\n"},
  {"name": "html: input checkbox", "markdown": "<input type=\"checkbox\" checked disabled> raw\n"},
  {"name": "html: div with markdown after blank line", "markdown": "<div align=\"center\">\n\n# Title\n\n</div>\n"},
  {"name": "html: unsafe link and image", "markdown": "[x](javascript:alert(1)) <a href=\"javascript:void(0)\">y</a> ![z](data:image/png;base64,AA)\n"},
  {"name": "entities and escapes", "markdown": "&copy; &nbsp; &#x1F600; &unknown; \\<b\\> \\& \\\\\n"},
  {"name": "headings with trailing hashes", "markdown": "# One #\n## Two ##   \n###### Six\n####### Seven\n"},
  {"name": "setext and thematic breaks", "markdown": "Title\n=====\n\nSub\n---\n\n***\n___\n- - -\n"},
  {"name": "nested blockquote and list", "markdown": "> - a\n>   > b\n> 1. c\n"},
  {"name": "code: info string with meta", "markdown": "```js title=\"x.js\" {1,2}\nlet a = 1;\n```\n\n~~~\ntilde\n~~~\n\n    indented\n"},
  {"name": "code: leading blank lines", "markdown": "```\n\n\nx\n```\n"},
  {"name": "ordered list: start and loose", "markdown": "3. a\n4. b\n\n   c\n"},
  {"name": "hard breaks", "markdown": "a  \nb\\\nc\n"},
  {"name": "images with titles", "markdown": "![alt *em*](/a.png \"Title\") ![](/b.png)\n"},
  {"name": "links: reference and title", "markdown": "[a][r] [b] [c](</u v> 'T')\n\n[r]: /r \"R\"\n[b]: /b\n"},
  {"name": "unicode text", "markdown": "Ünïcödé ✓ 中文 עברית 🎉\n"},
  {"name": "task list: two spaces after the marker", "markdown": "- [x]  two\n- [ ]\ttab\n- [x] \n  continued\n"}
]
